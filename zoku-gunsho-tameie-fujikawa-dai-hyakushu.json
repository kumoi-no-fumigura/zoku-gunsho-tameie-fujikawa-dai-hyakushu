   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "天の戸のあくる日母に忍ふとてしらぬむかしは色もかへらす",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "通日懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "いつるより神もさこそはねかふらめ君あきらかに民やすくとは",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頭祝言",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "東路に春やきぬらん開の戸もあくれはかすむあしからの山",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路早春",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "かすえぬと氷も今朝やとけぬらん汀にちかき志賀のうらなみ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "昨日まてそれとはみえし山本の梢もしらすかす無春かな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔遠樹",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "鶯は梅さく里匁のむらん宿さたまらぬ旅そかなしき",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇中閉党",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "おなしくは蟷ねの竹春枝かはすこなたにきなせうくひす草ゑ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隣家竹噌",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "いさゝらは山田の澤のうすこほりととれなは跡に若菜つみてん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田辺若菜",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "若草のつまもや雪にこもるらんまた春さむき武蔵野の原",
