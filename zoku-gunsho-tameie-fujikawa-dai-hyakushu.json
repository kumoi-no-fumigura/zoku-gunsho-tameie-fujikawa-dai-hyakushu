  },
  {
   "seq": "11",
   "text": "〽梅かゝをふきつく山の春風にいく木のもとの花になるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山路梅図",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "忘るへき春の夜の間の程を多に心もよほす梅のした風",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅薫夜風",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "沢水に去つ元枯たる川柳まちゆる春の色もすくなし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺古柳",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "草も木もかなしめくみの春雨に猶そさくらの枝もゆかしき",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中侍花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "行さきはくるゝもゑらぬ宿ならし花のか遣ふむ聖路の旅人",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野岡智人",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "一花の香と吹きて告か闇もうしおかめにかゝるみねのしら雲",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠望山花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "散かゝる庭の桜を多よりにてはるゝもつらし有ゆの月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁庵藤花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "おかめあかすけるもくらしのあすからやあすかの里の花のしらす",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "故郷夕花",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "行水は霜の下の音羽川いかにしほりてうつる月かけ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河上春月",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "一庵かねにあくる雨にうきあるさを深行空はさそなかならん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜飯雁",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "風わたる汀の松のしつえよりぬくかたしれとおひく藤おみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤花随風",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "風吹はこほれておつる款冬の花をわたせる谷のかけはし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋辺款冬",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "行者のかたを立らせにゆらの戸やこき出る船の跡のしほかせ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "舟中暑春",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "さゝに又遣ふ元人をみるは雪にたなき庭の卯花",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花隠路",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "きこゝも人にはいはしほとゝきすたのまぬ程の初音なりけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初聞郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "いまそ又さとなれはてゝほとゝきすむ山本のこゑそすくかき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "池水のみきはのあやめ朝な〳〵浪にかくなゝさみたれれころ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池朝菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "夏も猶狭をたにもたのむかなさひしき宿の夜半のかやり大",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閉居蚊火",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "哀なりたり袖の香のならひとて花橋に夢のこすらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "画橋驚夢",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "一榊さす秋のしめなはくり返しなはきいくかのさみたれのそら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一杜五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "あきゝかは風にもたへし草の原心とむすへ野への遊ふつめ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野夕夏草",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "すむとたにしられぬ谷の下水をありとほたるそもへて告ける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "洞底昼火",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "さらてたに草わけわふるぬれ衣日も夕立の雨きほふなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路夕立",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "夏衣またかたしきのさむしろに今朝鳴とをすあきのはつ風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初秋朝風",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "ふた夜まてかにそかありて天河のちせわたらぬほしあひの空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閏月七夕",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "一秋はきの花の戸さしの色にいてゝ夕暮去るき野への露哉と",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野亭夕萩",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "暁はうきねもさひし舟とむか入江の夜にわたるあきかせ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江辺曙夜",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "すきぬかりわかすむ山のもみち葉に涙しらするはつかりの声",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家初丁",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "さしいつるゆかりはうれし月はまたつれなき沖のあまのつりに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海上侍月",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "一住吉の浦半の波は音も世斎月よりかゝる松のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松同夜月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "山ふかくわれからむすら草の庵に人々すむとや月のもならん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深山見月",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "あきのよは露の庭なる草葉まてとをりてすめる月の影哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草露映月",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "よせかへりなにしか浪の清見た月をとをさぬ関間もなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "開路惜同",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "夜半に鳴山ちのしかのこゑなくはひとりそろきの袖はぬれまし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿老夜友",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "一月のすむ田中の房のいなむしろもるやすさひに衣うつおり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "一読おきすこと川原のあき霧に都とふへき音たにもなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古渡稲霧",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "しら露もみなから草のむさし野を吹たにたへぬ蜘の夕風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "桃風満非",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "風わたる籬の草の下おれにうつもれはてぬ松むしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬下関虫",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "散かゝる色たにあかしもみちそのかけ見るかたの水のかゝみは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉馬水",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "あきにあへぬ三宝の山のもみち葉は草葉をかけていつ時雨けん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中死家",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "哀なりきゆるにやすき白露をやとしよはれるちさかほのはな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露底権花",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "いく子世を世きて岩間にとゝむさん菊のかれ行谷川の水",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河辺菊花",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "あはれともくれゆく秋もおもひしれ我女ひとつにおしむこゝろを",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橘惜春秋",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "わすれては猶あきそともおもはましわれをもしらぬしくれならせは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "ちりしよりあさをく案にうつもれてわか色とし夫へぬもみろ葉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜埋落葉",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "あられふる真木の板屋のかたひさし音にたてゝそ冬は来に気も",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "屋上開霞",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "降そむき雪より諸そ後ぬへき高野の山の冬の人めは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺初雪",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "〽今よりは人をもとはし降雪の庭にはあともつれうかりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪歇人",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "難波かたあさみつ塩はとをけれと雪［ニかくなみらの松はら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺松雪",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "けなか芦のしほれ葉ふきさやきこほりもよほすまのゝ浪かせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水郷寒兼",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "風さむて興津さゝ浪さく図に色まとはせる浦ちとりかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "かつこほる池の玉藻のかりまくらむすふ参夜にをしうらむ也",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒夜水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "谷川のはやく暮ゆくねそにむすふ氷もあすやとくへき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮湖水",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "今日こそは浦半にますかみるめをもしらする風を尋ねそめつれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初尋縁恋",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "夢かとよみしを心におくさめて又よそになるゆしくれのそら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "同常恩恋",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "哀なりたかまことなるぢきりとておしむ命も年をへぬらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "安経年恋",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "たのめしは猶偽のくれかともおもひさためて身をくたかはや",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "疑契偽恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "ひき返すうらにかきをくもしほ草やかて涙にくちぬへきかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返事増恋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "人そうき賤のをたまきいやしきを身をしるとかはなきになされて",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被厭賤恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "めくりあはん末をそまのむ道のへのゆき別ぬるあたまちきりは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "途中契恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "秋の夜のあけせぬ真木のとはかりにゆきてはかへる袖をみせはや",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "「従門帰応",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "われそうきそことはそこをしら雪のをしへし月の願は入にき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘住所恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "今は多か恋をいのりになしはてゝあらはとはかり身をおしむかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "依恋祈身",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "〽我心いく山川をかくかれてしもらのおくにみちたとるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隔遠路恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "一外さまに名をかる草のつかの間もおひくにつけて身そしくれぬ方",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借人名恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "おなし世におしやありやもしら浪のよるへ給にし方のなかはま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶不知応",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "今は又ゆく君もゑらす諸絶ぬかたみにふきしくすのこら風",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "在恨絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "一枕たにうきたちぬへきねさめかなむしおほゆる暁のかね",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁更寝覚",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "そのことしおもはぬ暮もかなしきは松いわたるあらし也けり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落春松風",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "雨をもきまかきの竹の出れかへりくたれはのほる露の白玉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雨中縁竹",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "波あらふ磯辺の石の吉衣同す間そ之へぬ興津しほかせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浪洗石苔",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "よのつねの峰には影も出なまし富士の称しらむ秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高山侍月",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "山にても猶うきときやまさるらんみたれも落る瀧のしら",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中瀧水",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "一庭まてもなかれてきよし神風やいすゝの河の水の白浪",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河水流清",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "一桜花千代も取ぬへくみしのへに妊さく色のうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春秋秋遊",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "くれ行はそのふの山に吹嵐なれすはいかにこゝろうかれん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路行客山家夕嵐",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "われすのゝ雲しく岩の峯のいほ。われより外の諸をやはこる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家人稀",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "わたの原波路の末ハ中絶て雲にうきたつあまのつりふね",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路眺望",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "旅のそらうきて出にし野山まて道もやとりも月そともなふ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一月羇中友",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "都おもふ涙も露もかりのやに猶もる夜半の雨しほりつゝ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿夜雨",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "くらき夜の八重のしほちの波間よりはかれてあくる空の横雲",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺暁雲",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "あるも夢かきも夢そといひなかられに御とられぬ身をいかにしん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一夢無常",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "一世中をわきてはいはす夏草のたゝわれからと露そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草述懐",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "一世中はあまの塩木のかしくのはありふる皮々におもひとられよう",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木述懐",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "過にける昔を今とおもふまにけふもきいふとなりぬへきかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "通日懐洞",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "ゆるきなくときはかきはにまもるらんいすゝの河の神のこや扨は",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734030",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頭祝言",
   "kotobagaki": ""
  }
 ],
